# Supabase client configuration (publishable values are browser-safe when RLS is enabled)
NEXT_PUBLIC_SUPABASE_URL=https://kbgzrefivxqoiwumfyui.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# OpenRouter Copilot (server-side only; never prefix the API key with NEXT_PUBLIC_)
OPENROUTER_API_KEY=
OPENROUTER_MODEL_FAST=openai/gpt-5.6-luna
OPENROUTER_MODEL_REASONING=openai/gpt-5.6-sol

# Optional dormant ChatGPT identity adapter. This is not used for Copilot inference.
NEXT_PUBLIC_CHATGPT_AUTH_ENABLED=false
NEXT_PUBLIC_CHATGPT_AUTH_PROVIDER=custom:chatgpt

# App attribution / OAuth callback base
APP_URL=http://localhost:3000
