# Supabase client configuration (publishable values are browser-safe when RLS is enabled)
NEXT_PUBLIC_SUPABASE_URL=https://kbgzrefivxqoiwumfyui.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# OpenAI Responses API (server-side only; never prefix with NEXT_PUBLIC_)
OPENAI_API_KEY=
OPENAI_MODEL_REASONING=gpt-5.6
OPENAI_MODEL_FAST=gpt-5.6

# Optional ChatGPT identity provider. Enable only after OpenAI issues OAuth partner credentials
# and Supabase custom provider `custom:chatgpt` has been configured.
NEXT_PUBLIC_CHATGPT_AUTH_ENABLED=false
NEXT_PUBLIC_CHATGPT_AUTH_PROVIDER=custom:chatgpt

# App
APP_URL=http://localhost:3000
