# Supabase client configuration. Both values are required together.
# Local verification should use an explicitly configured loopback/disposable project.
# Do not put a production project URL here as a fallback.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-or-deployment-publishable-key

# Server-only Supabase credential used exclusively for privileged governed boundaries.
# Never expose this value to browser code or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter Copilot (server-side only; never prefix the API key with NEXT_PUBLIC_)
# AI is optional and is not part of deterministic schedule legality.
OPENROUTER_API_KEY=
OPENROUTER_MODEL_FAST=openai/gpt-5.6-luna
OPENROUTER_MODEL_REASONING=openai/gpt-5.6-sol

# Private CP-SAT feasibility service. These values are server-only and must never use NEXT_PUBLIC_.
SOLVER_SERVICE_URL=
SOLVER_INTERNAL_TOKEN=
SOLVER_MAX_SECONDS=10

# App attribution / OAuth callback base
APP_URL=http://localhost:3000
